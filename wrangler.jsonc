{
	"name": "softskilllabs",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// No id: `wrangler deploy` creates the namespace on first deploy and keeps it bound to this Worker.
	"kv_namespaces": [{ "binding": "POSTS" }],
	// Photos in journal posts; created on first deploy the same way.
	"r2_buckets": [{ "binding": "PHOTOS" }],
	"observability": {
		"enabled": true
	}
}
