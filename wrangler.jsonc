{
	"name": "softskilllabs",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_als"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Workers Builds can't create resources on deploy, so they are named here. Local dev keeps its own copies.
	"kv_namespaces": [
		{
			"binding": "POSTS",
			"id": "43218b37d8a941c4bc9f48a200b8335d"
		}
	],
	// Photos in journal posts. The editor hides its photo buttons when this binding is missing.
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "softskilllabs-photos"
		},
		{
			"bucket_name": "softskilllabs-photos",
			"binding": "softskilllabs_photos"
		}
	],
	"observability": {
		"enabled": true
	}
}