{
	"name": "softskilllabs",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Workers Builds can't create resources on deploy, so they are named here. Local dev keeps its own copies.
	"kv_namespaces": [{ "binding": "POSTS", "id": "43218b37d8a941c4bc9f48a200b8335d" }],
	// Photos in journal posts. The editor hides its photo buttons when this binding is missing.
	"r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "softskilllabs-photos" }],
	// At most 5 login attempts a minute from one address (/adm/login). namespace_id is any number unique to this account.
	"ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
	// The live address is the only one: without this a deploy turns the workers.dev copy of the site back on.
	"workers_dev": false,
	"routes": [{ "pattern": "softskilllabs.com", "custom_domain": true }],
	"observability": {
		"enabled": true
	}
}
