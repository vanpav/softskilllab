{
	"name": "softskilllabs",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Workers Builds can't create resources on deploy, so they are named here. Local dev keeps its own copies.
	"kv_namespaces": [{ "binding": "POSTS", "id": "43218b37d8a941c4bc9f48a200b8335d" }],
	// Photos in journal posts. Off until R2 is enabled on the account and the bucket exists:
	// wrangler r2 bucket create softskilllabs-photos, then uncomment. The editor hides photo buttons without it.
	// "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "softskilllabs-photos" }],
	"observability": {
		"enabled": true
	}
}
