{
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/package-lock.json)",
      "Read(**/*.log)",
      "Read(**/*.min.js)",
      "Read(**/*.map)",
      "Read(**/*.zip)",
      "Read(**/*.tar.gz)",
      "mcp__c0d9ccd9-4491-4f63-9509-0a352a5d9136",
      "mcp__plugin_design_atlassian",
      "mcp__c57bce5f-b43a-4e42-8847-2b51f85b67fd",
      "mcp__plugin_design_figma"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rewrite-bash.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": false,
    "marketing-skills@marketingskills": false
  }
}
