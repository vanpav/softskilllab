{
	"name": "softskilllabs",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs --test src/lib/*.test.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "wrangler dev",
		"deploy": "pnpm build && wrangler deploy"
	},
	"devDependencies": {
		"@fontsource-variable/caveat": "^5.3.0",
		"@fontsource-variable/onest": "^5.3.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"cn": "^0.5.2",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.158.0"
	},
	"packageManager": "pnpm@10.25.0"
}
